# syntax=docker/dockerfile:1.6

FROM ghcr.io/graalvm/native-image-community:21 AS builder

WORKDIR /app

COPY . .

RUN chmod +x mvnw

# Use BuildKit cache (IMPORTANT FIX)
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -Pnative native:compile -DskipTests

# Runtime image
FROM ubuntu:24.04

WORKDIR /app

COPY --from=builder /app/target/mentee-connect app

RUN chmod +x app

EXPOSE 8080

ENTRYPOINT ["./app"]